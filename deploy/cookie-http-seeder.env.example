# Example environment file for systemd / Docker / bare metal.
# Copy to data dir or /etc/cookie-http-seeder.env and adjust.

COOKIE_HTTP_SEEDER_DATA=/var/lib/cookie-http-seeder
COOKIE_HTTP_SEEDER_HOST=127.0.0.1
COOKIE_HTTP_SEEDER_PORT=18765

# Prefer a file under the data dir (mode 0600) instead of putting the token here.
# COOKIE_HTTP_SEEDER_TOKEN=
# COOKIE_HTTP_SEEDER_TOKEN_FILE=/var/lib/cookie-http-seeder/cookie-receiver.token

# Optional: pin sources for this host (also auto-loaded from $DATA/sources.json)
# COOKIE_HTTP_SEEDER_SOURCES=/var/lib/cookie-http-seeder/sources.json

# Optional Feishu webhook file (mode 0600)
# COOKIE_HTTP_SEEDER_WEBHOOK_FILE=/var/lib/cookie-http-seeder/feishu-webhook
# COOKIE_HTTP_SEEDER_NO_NOTIFY=1
